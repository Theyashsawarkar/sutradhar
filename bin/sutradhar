#!/bin/sh
# sutradhar: the daemon, the MCP server and the command line (see --help).
here=$(dirname "$(readlink -f "$0")")
# `sutradhar mcp` is the small sutradhar-mcp pipe when it's built (the daemon
# serves the MCP session); it falls back to node itself.
if [ "$1" = mcp ] && [ -x "$here/../dist/sutradhar-mcp" ]; then
  shift
  exec "$here/../dist/sutradhar-mcp" "$@"
fi
exec node "$here/../dist/sutradhar.mjs" "$@"
